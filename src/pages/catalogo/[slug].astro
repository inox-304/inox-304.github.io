---
import { withBase } from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductMedia from '../../components/ProductMedia.astro';
import ProductCommerce from '../../components/ProductCommerce.astro';
import ProductFamily from '../../components/ProductFamily.astro';
import { catalogFamilyProducts, getProductFamily } from '../../lib/product-families';
import { visibleProducts } from '../../data/catalog';
import { categories, type Product } from '../../data/products';
import { whatsappUrl } from '../../data/site';
import { formatProductPrice, productQuoteNote } from '../../lib/cms';
export function getStaticPaths() { return visibleProducts.map(product => ({ params: { slug: product.slug }, props: { product } })); }
interface Props { product: Product }
const { product } = Astro.props;
const category = categories.find(item => item.id === product.category)!;
const family = getProductFamily(product.id, visibleProducts);
const familyIds = new Set(family?.members.map(member => member.product.id) || [product.id]);
const related = catalogFamilyProducts(visibleProducts).filter(item => item.category === product.category && !familyIds.has(item.id)).slice(0, 3);
const productUrl = new URL(withBase(`/catalogo/${product.slug}/`), Astro.site);
const configuration = family?.selectorLabel ? family.members.find(member => member.product.id === product.id)?.label : '';
const quoteUrl = whatsappUrl(`Hola INOX 304, me interesa ${product.name} (código ${product.id}).${configuration ? ` ${family!.selectorLabel}: ${configuration}.` : ''} Me gustaría conocer las opciones y recibir una cotización. ${productUrl}`, product.contactId);
---
<Layout title={product.name} description={product.summary} image={product.image}>
  <section class="section-light product-page" data-product-detail={product.id}><div class="shell">
    <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href={withBase('/')}>Inicio</a><span>/</span><a href={withBase('/catalogo/')}>Catálogo</a><span>/</span><a data-product-category data-product-category-link href={withBase(`/catalogo/?categoria=${category.id}`)}>{category.shortName}</a></nav>
    <div data-product-unavailable hidden role="status"><h2>Este equipo ya no está disponible en el catálogo.</h2><p>Explora los equipos actuales o consulta con nuestro equipo.</p><a class="button button-dark" href={withBase('/catalogo/')}>Ver catálogo</a></div><div class="product-detail-grid"><ProductMedia product={product} category={category.name}/><div class="product-detail-copy"><span class="eyebrow" data-product-category>{category.name}</span><h1 data-product-name>{product.name}</h1><p class="product-summary" data-product-summary>{product.summary}</p><ProductCommerce product={product}><ProductFamily product={product} products={visibleProducts}/></ProductCommerce><div class="product-detail-cta"><a class:list={["button", "button-quote", formatProductPrice(product) ? "button-dark" : "button-chrome"]} data-product-quote href={quoteUrl} target="_blank" rel="noopener noreferrer">Cotizar este equipo <Icon name="whatsapp"/></a><p data-product-quote-note>{productQuoteNote(product)}</p></div><p><a class="text-link dark-link" data-product-inquiry href={withBase('/contacto/') + '?' + new URLSearchParams({ product_code: product.id, configuration: product.name })}>Enviar solicitud con esta configuración <Icon name="arrow" size={17}/></a></p><div class="specifications"><h2>Detalles que hacen la diferencia</h2><ul data-product-features>{product.features.map(feature => <li><Icon name="check" size={17}/><span>{feature}</span></li>)}</ul></div><a class="text-link dark-link" href={withBase('/contacto/')}>¿Necesitas ayuda para elegir? <Icon name="arrow" size={17}/></a></div></div>
    {related.length > 0 && <section class="related-products"><div class="section-heading"><div><span class="eyebrow">COMPLETA TU ESPACIO</span><h2>También te puede interesar.</h2></div><a class="text-link dark-link" data-product-category-link href={withBase(`/catalogo/?categoria=${category.id}`)}>Ver categoría <Icon/></a></div><div class="product-grid">{related.map((item, index) => <ProductCard product={item} products={visibleProducts} index={index}/>)}</div></section>}
  </div></section>
</Layout>

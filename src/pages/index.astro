---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HomeCategories from '../components/HomeCategories.astro';
import FeaturedRail from '../components/FeaturedRail.astro';
import BlueprintStory from '../components/BlueprintStory.astro';
import Services from '../components/Services.astro';
---
<Layout home>
  <section class="hero" aria-labelledby="hero-heading">
    <svg class="hero-color-grade" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <filter id="inox-hero-blue-grade" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
          <feComponentTransfer in="SourceGraphic" result="blueScene">
            <feFuncR type="table" tableValues="0 .002 .008 .018 .045 .105 .22 .46 .73 .93 1"/>
            <feFuncG type="table" tableValues=".004 .018 .04 .075 .13 .22 .35 .56 .79 .95 1"/>
            <feFuncB type="table" tableValues=".014 .05 .10 .16 .23 .33 .46 .66 .86 .97 1"/>
          </feComponentTransfer>
          <feComponentTransfer in="SourceGraphic" result="steelLight">
            <feFuncR type="table" tableValues="0 .025 .08 .17 .29 .44 .61 .77 .88 .96 1"/>
            <feFuncG type="table" tableValues="0 .025 .08 .17 .29 .44 .61 .77 .88 .96 1"/>
            <feFuncB type="table" tableValues="0 .025 .08 .17 .29 .44 .61 .77 .88 .96 1"/>
          </feComponentTransfer>
          <feImage href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cdefs%3E%3Cfilter id='soft' x='-50%25' y='-50%25' width='200%25' height='200%25'%3E%3CfeGaussianBlur stdDeviation='4'/%3E%3C/filter%3E%3C/defs%3E%3Crect x='29' y='24' width='58' height='58' rx='5' fill='white' opacity='.65' filter='url(%23soft)'/%3E%3C/svg%3E" preserveAspectRatio="none" x="0" y="0" width="100%" height="100%" result="steelMask"/>
          <feComposite in="steelLight" in2="steelMask" operator="in" result="silverHighlights"/>
          <feComposite in="blueScene" in2="steelMask" operator="out" result="blueSurroundings"/>
          <feComposite in="blueSurroundings" in2="silverHighlights" operator="arithmetic" k2="1" k3="1"/>
        </filter>
      </defs>
    </svg>
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <div class="hero-stage" aria-hidden="true">
      <video id="hero-video" class="hero-video" data-src-desktop={withBase('/media/hero-clean.mp4')} data-poster-desktop={withBase('/media/hero-poster.jpg')} data-src-tablet={withBase('/media/hero-tablet.mp4')} data-poster-tablet={withBase('/media/hero-tablet-poster.jpg')} data-src-mobile={withBase('/media/hero-mobile.mp4')} data-poster-mobile={withBase('/media/hero-mobile-poster.jpg')} muted loop playsinline preload="none"><source type="video/mp4"/></video>
      <noscript><picture class="hero-static"><source media="(max-width:600px)" srcset={withBase('/media/hero-mobile-poster.jpg')}/><source media="(max-width:1100px)" srcset={withBase('/media/hero-tablet-poster.jpg')}/><img src={withBase('/media/hero-poster.jpg')} alt=""/></picture></noscript>
      <div class="hero-stage-shade"></div>
    </div>
    <div class="hero-inner shell">
      <div class="hero-copy">
        <span class="eyebrow hero-eyebrow"><span class="tiny-line"></span> EQUIPAMIENTO QUE TRANSFORMA</span>
        <h1 id="hero-heading" data-business="hero_title">Acero que<br/>impulsa<br/>tu <em>negocio.</em></h1>
        <p data-business="hero_description">Diseño preciso. Fabricación a medida.<br/>Equipos preparados para tu siguiente gran idea.</p>
        <div class="hero-actions"><a class="button button-light" href="#coleccion">Descubre nuestras líneas <Icon name="diagonal"/></a><a class="text-link" href="#a-medida">Tu proyecto a medida <Icon size={17}/></a></div>
      </div>
      <div class="hero-foot"><a class="scroll-cue" href="#coleccion"><span>↓</span> DESCUBRE INOX 304</a><div class="hero-foot-note"><span class="live-dot"></span> DISEÑADO PARA EXIGIRLE MÁS</div><button class="video-toggle" aria-label="Reproducir video de presentación" aria-pressed="false"><span data-video-icon>▶</span><span data-video-label>Reproducir</span></button></div>
    </div>
  </section>

  <section class="value-strip" aria-label="Nuestra especialidad"><div class="shell value-strip-inner"><div><span class="value-number">304</span><span>ACERO INOXIDABLE<br/><b>AISI 304</b></span></div><span class="value-rule"></span><div><span class="value-symbol">↗</span><span>DE LA IDEA AL ESPACIO<br/><b>Fabricación a medida</b></span></div><span class="value-rule"></span><div><span class="value-symbol">◎</span><span>DESDE CUSCO Y LIMA<br/><b>Envíos a todo el Perú</b></span></div></div></section>

  <HomeCategories/>
  <FeaturedRail/>
  <BlueprintStory/>

  <Services/>

  <section id="nosotros" class="section section-light about-section"><div class="shell">
    <div class="section-heading"><div><span class="eyebrow">04 / DE PRINCIPIO A FIN</span><h2>Más que equipos.<br/><span class="soft-text">Un proyecto contigo.</span></h2></div><p class="about-intro" data-business="home_text">En INOX 304 unimos diseño, fabricación e instalación de equipamiento gastronómico. Acompañamos a restaurantes, hoteles, cafeterías y negocios que quieren dar el siguiente paso.</p></div>
    <div class="process-grid">{[{n:'01',title:'Lo imaginamos',text:'Escuchamos tu idea, conocemos tu espacio y definimos contigo lo que necesitas.'},{n:'02',title:'Lo fabricamos',text:'Damos forma a tu proyecto en acero inoxidable, con medidas y acabados para tu operación.'},{n:'03',title:'Lo implementamos',text:'Instalamos tus equipos y coordinamos las pruebas para poner tu proyecto en marcha.'}].map(item => <article class="process-card"><div><span>{item.n}</span><Icon name="plus" size={18}/></div><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    <div class="sector-line"><span class="eyebrow">UN EQUIPO PARA CADA NEGOCIO</span><p>Restaurantes <span>·</span> Hoteles <span>·</span> Cafeterías <span>·</span> Panaderías <span>·</span> Pollerías</p></div>
  </div></section>

  <section class="contact-band"><div class="shell"><div><span class="eyebrow">EL SIGUIENTE PASO EMPIEZA AQUÍ</span><h2>Hagamos espacio<br/>para tu próximo proyecto.</h2></div><a class="circle-cta" href={withBase('/contacto/')} aria-label="Conversemos sobre tu proyecto"><Icon name="diagonal" size={42}/></a></div></section>
</Layout>
<style>
  .hero{--hero-depth:#00101f;height:100svh;min-height:740px;max-height:950px;background:var(--hero-depth);color:#f5faff}
  .hero-atmosphere{background:radial-gradient(ellipse at 39% 34%,rgba(4,55,108,.22),transparent 55%),linear-gradient(90deg,rgba(0,16,31,.8),rgba(3,33,58,.35) 52%,rgba(3,29,52,.35)),url('/images/brand/stone-texture.webp') center/cover;filter:saturate(1.35) contrast(1.15);opacity:1}
  .hero-color-grade{position:absolute;pointer-events:none}
  /* Cool the footage itself; converge to neutral highlights so steel stays silver. */
  .hero-video{filter:url(#inox-hero-blue-grade);opacity:1}
  .hero-video[data-hero-media="mobile"],.hero-video[data-hero-media="tablet"]{filter:none}
  .hero-static{position:absolute;inset:0}.hero-static img{width:100%;height:100%;object-fit:cover;filter:url(#inox-hero-blue-grade)}
  .hero-stage-shade{background:linear-gradient(90deg,var(--hero-depth),rgba(0,16,31,.66) 12%,transparent 40%),linear-gradient(0deg,var(--hero-depth),transparent 25%,transparent 82%,rgba(0,16,31,.5))}
  .hero-stage-shade::after{content:"";position:absolute;inset:0;background:transparent;pointer-events:none}
  .hero-stage{mask-image:linear-gradient(90deg,transparent,#000 28%)}
  .hero-copy{padding-top:145px;padding-bottom:105px}
  .hero em{color:inherit;background:none;-webkit-text-fill-color:currentColor;filter:none}
  .hero-copy>p{color:#d0dfeb}
  .hero-eyebrow,.hero-foot-note,.scroll-cue{color:#c1d8e9}
  .hero .tiny-line,.hero .live-dot{background:#7abfea}
  .hero-actions>.text-link{color:#d0e3f1}
  .hero .video-toggle{background:rgba(0,16,31,.7);border-color:#577f9c;color:#e6f3ff}
  .hero .video-toggle:hover{background:#123e5d;border-color:#92bedd}
  @media(min-width:901px) and (max-width:1100px){.hero-stage{top:50%;left:47%;right:0;bottom:auto;height:auto;aspect-ratio:4/3;transform:translateY(-50%);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent),linear-gradient(180deg,transparent,#000 12%,#000 90%,transparent);mask-composite:intersect}.hero-video,.hero-static img{object-fit:contain;object-position:center}.hero-stage-shade{background:linear-gradient(90deg,var(--hero-depth),transparent 12%),linear-gradient(0deg,var(--hero-depth),transparent 20%,transparent 90%,var(--hero-depth))}}
  @media(max-width:1100px){.hero-static img{filter:none}}
  @media(max-width:900px){.hero,.hero-inner{height:auto;min-height:1100px}.hero-copy{padding-top:128px;padding-bottom:560px}.hero-stage{top:560px;left:4%;right:4%;bottom:66px;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent),linear-gradient(180deg,transparent,#000 12%,#000 90%,transparent);mask-composite:intersect}.hero-video,.hero-static img{object-fit:contain;object-position:center}.hero-stage-shade{background:linear-gradient(180deg,var(--hero-depth),transparent 12%,transparent 90%,var(--hero-depth))}}
  @media(max-width:600px){.hero,.hero-inner{min-height:890px}.hero-copy{padding-top:124px;padding-bottom:385px}.hero-stage{top:0;left:0;right:0;bottom:66px;mask-image:linear-gradient(180deg,#000,#000 92%,transparent);mask-composite:add}.hero-video,.hero-static img{object-fit:cover;object-position:center}.hero-stage-shade{background:linear-gradient(0deg,var(--hero-depth),transparent 10%)}}
</style>
<script>import '../scripts/hero-video';</script>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CmsBridge from '../components/CmsBridge.astro';
import '../styles/global.css';
import '../styles/motion.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string; image?: string; home?: boolean; noindex?: boolean }
const { title = 'Acero que impulsa tu negocio', description = site.description, image = '/images/hero-studio.webp', home = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title} | INOX 304</title><meta name="description" content={description}/>
    <meta name="theme-color" content="#111414"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex"/>}
    <meta property="og:type" content="website"/><meta property="og:locale" content="es_PE"/><meta property="og:site_name" content="INOX 304"/><meta property="og:title" content={`${title} | INOX 304`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image, Astro.site)}/>
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin/>
    <slot name="head"/>
  </head>
  <body id="top" class:list={[{ 'home-page': home }]}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header/>
    <main id="main"><slot/></main>
    <Footer/>
    <CmsBridge/>
    <script>import '../scripts/motion';</script>
  </body>
</html>

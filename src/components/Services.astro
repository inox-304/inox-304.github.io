---
import Icon from './Icon.astro';
import InstallationFilms from './InstallationFilms.astro';
import { whatsappUrl } from '../data/site';
const services = [
  {title:'Montaje y puesta en marcha', text:'Instalación de tus equipos y pruebas de funcionamiento en tu cocina.'},
  {title:'Extracción y ductería', text:'Campanas y ductos adaptados a la distribución de tu espacio.'},
  {title:'Redes de gas', text:'Instalación y conexión de la red de gas para tu proyecto.'},
  {title:'Mantenimiento', text:'Revisión y atención técnica para tus equipos gastronómicos.'},
];
---
<section id="instalaciones" class="installation-section" aria-labelledby="installation-title">
  <div class="shell">
    <div class="installation-heading">
      <h2 id="installation-title">Instalación y soporte.</h2>
      <a class="button button-quote" data-contact-setting="contacto_instalaciones" href={whatsappUrl('Hola INOX 304, quiero asesoría para un proyecto de instalación.')} target="_blank" rel="noopener noreferrer">Consultar un servicio <Icon name="diagonal" size={18}/></a>
    </div>
    <ul class="service-list" aria-label="Servicios de instalación y soporte">
      {services.map((service,index) => <li class="service-item">
        <span class="service-number" aria-hidden="true">0{index+1}</span>
        <h3>{service.title}</h3>
        <p>{service.text}</p>
      </li>)}
    </ul>
    <InstallationFilms/>
  </div>
</section>
<style>
  .installation-section{padding-block:56px 72px;scroll-margin-top:90px;background-color:#00101f;background-image:linear-gradient(110deg,rgba(0,16,31,.95),rgba(3,26,48,.88) 58%,rgba(5,34,60,.8)),url('/images/brand/stone-texture.webp');background-position:center;background-size:cover;color:#f5faff}
  .installation-heading{display:flex;justify-content:space-between;align-items:center;gap:26px;margin-bottom:32px}
  .installation-heading h2{font-size:clamp(28px,3vw,40px);font-weight:500;line-height:1.15;letter-spacing:-1.2px;margin:0}
  .installation-heading .button{flex-shrink:0;font-size:12px;gap:22px}
  .service-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px;margin:0;padding:0;list-style:none}
  .service-item{border-top:1px solid rgb(132 186 220 / 42%);padding-top:17px}
  .service-number{display:block;color:#8fc5e8;font-size:10px;font-variant-numeric:tabular-nums;margin-bottom:12px}
  .service-item h3{font-size:17px;font-weight:500;line-height:1.35;letter-spacing:-.3px;margin:0 0 10px}
  .service-item p{color:#d0dfeb;font-size:12px;line-height:1.8;margin:0;max-width:285px}
  @media(max-width:1000px){.service-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:27px}.installation-heading{gap:20px}}
  @media(max-width:600px){.installation-section{padding-block:38px 48px}.installation-heading{align-items:flex-start;flex-direction:column;gap:19px;margin-bottom:28px}.installation-heading h2{font-size:30px;letter-spacing:-.8px}.installation-heading .button{font-size:11px;min-height:46px}.service-list{gap:24px 18px}.service-item h3{font-size:15px}.service-item p{font-size:11px;line-height:1.75}}
  @media(max-width:350px){.service-list{grid-template-columns:1fr}}
</style>

---
import { withBase } from '../lib/paths';
// Adapted from ScrewFast's linked product-card structure; see LICENSE-SCREWFAST.
import Icon from './Icon.astro';
import type { Product } from '../data/products';
import { categories } from '../data/products';
import { formatProductPrice } from '../lib/cms';
import { whatsappUrl } from '../data/site';
import { catalogSearchText } from '../lib/catalog-controls';
interface Props { product: Product; index?: number; href?: string }
const { product, index = 0, href = withBase(`/catalogo/${product.slug}/`) } = Astro.props;
const category = categories.find(item => item.id === product.category);
const price = formatProductPrice(product);
const quoteUrl = whatsappUrl(`Hola INOX 304, me interesa ${product.name}. Me gustaría recibir una cotización.`, product.contactId);
---
<article class="product-card product-photo-white" data-product-id={product.id} data-category={product.category} data-title={product.name} data-catalog-order={index} data-name={catalogSearchText(product, category?.name || '')}>
  <a class="product-card-main" href={href}>
  <div class="product-card-image"><span class="product-index">{String(index + 1).padStart(2, '0')}</span><img src={withBase(product.image)} alt={product.name} loading="lazy" decoding="async" width="640" height="520"/><span class="product-arrow"><Icon name="diagonal" size={22}/></span></div>
  <div class="product-card-info"><div class="product-card-meta"><p class="eyebrow">{category?.shortName}</p><span class="product-card-code" data-card-code>{product.id}</span></div><h3>{product.name}</h3><span class="card-link">Explorar equipo <Icon name="arrow" size={15}/></span></div>
  </a>
  <div class="product-card-commerce">
    <p class="product-card-price" data-card-price hidden={!price}>{price}</p>
    <a class="button button-chrome product-card-quote" data-card-quote href={quoteUrl} target="_blank" rel="noopener noreferrer" aria-label={`Cotizar ${product.name}`} hidden={!!price}>Cotizar <Icon name="whatsapp" size={16}/></a>
  </div>
</article>

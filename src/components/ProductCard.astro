---
import { withBase } from '../lib/paths';
// Adapted from ScrewFast's linked product-card structure; see LICENSE-SCREWFAST.
import Icon from './Icon.astro';
import type { Product } from '../data/products';
import { categories } from '../data/products';
import { formatProductPrice } from '../lib/cms';
import { whatsappUrl } from '../data/site';
import { catalogSearchText } from '../lib/catalog-controls';
import { getProductFamily } from '../lib/product-families';
import { getProductStage } from '../lib/product-stage';
import { catalogListingHref, catalogListingSearchText, type CatalogListing } from '../lib/catalog-listings';
import { getCatalogType } from '../lib/catalog-taxonomy';
import '../styles/product-family.css';
import '../styles/product-photo.css';
interface Props { product: Product; products?: Product[]; index?: number; href?: string; listing?: CatalogListing<Product> }
const { product, products = [], index = 0, listing } = Astro.props;
const href = listing ? catalogListingHref(listing, Astro.props.href || withBase(`/catalogo/${product.slug}/`)) : Astro.props.href || withBase(`/catalogo/${product.slug}/`);
const family = listing ? null : getProductFamily(product.id, products);
const title = listing?.title || family?.name || product.name;
const photoSource = listing?.image || product.image;
const photo = getProductStage(photoSource);
const category = categories.find(item => item.id === product.category);
const search = listing ? catalogListingSearchText(listing, category?.name || '') : family ? [family.name, ...family.members.map(member => `${member.label} ${catalogSearchText(member.product, category?.name || '')}`)].join(' ') : catalogSearchText(product, category?.name || '');
const price = formatProductPrice(listing ? { ...product, price: listing.price } : product);
const optionLabel = listing?.label || (family ? family.cardSummary || `${family.members.length} ${family.members.length === 1 ? 'modelo disponible' : 'modelos disponibles'}` : '');
const fullName = listing?.variant ? `${title} · ${listing.label}` : product.name;
const quoteUrl = whatsappUrl(`Hola INOX 304, me interesa ${fullName}. Me gustaría recibir una cotización.`, product.contactId);
---
<article class="product-card product-photo-white" data-product-id={product.id} data-listing-key={listing?.key} data-variant-id={listing?.variant?.id} data-product-type={getCatalogType(product)?.id || ''} data-category={product.category} data-title={listing ? `${title} ${listing.label}` : title} data-catalog-order={index} data-name={search}>
  <a class="product-card-main" href={href}>
  <div class="product-card-image"><span class="product-index">{String(index + 1).padStart(2, '0')}</span><img data-product-photo style={photo.photoStyle} src={withBase(photoSource)} alt={fullName} loading="lazy" decoding="async" width={photo.width} height={photo.height}/><span class="product-arrow"><Icon name="diagonal" size={22}/></span></div>
  <div class="product-card-info"><div class="product-card-meta"><p class="eyebrow">{category?.shortName}</p><span class="product-card-code" data-card-code>{product.id}</span></div><h3>{title}</h3><p class="product-card-family" data-card-family hidden={!optionLabel}>{optionLabel}</p><span class="card-link"><span data-card-link-label>{listing?.variant ? 'Ver esta versión' : family ? family.cardAction || 'Elegir capacidad / modelo' : 'Explorar equipo'}</span> <Icon name="arrow" size={15}/></span></div>
  </a>
  <div class="product-card-commerce">
    <p class="product-card-price" data-card-price hidden={!price}>{price}</p>
    <a class="button button-chrome button-quote product-card-quote" data-card-quote href={quoteUrl} target="_blank" rel="noopener noreferrer" aria-label={`Cotizar ${fullName}`} hidden={!!price}>Cotizar <Icon name="whatsapp" size={16}/></a>
  </div>
</article>

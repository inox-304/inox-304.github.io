---
import { withBase } from '../lib/paths';
// Adapted from ScrewFast's linked product-card structure; see LICENSE-SCREWFAST.
import Icon from './Icon.astro';
import type { Product } from '../data/products';
import { categories } from '../data/products';
interface Props { product: Product; index?: number }
const { product, index = 0 } = Astro.props;
const category = categories.find(item => item.id === product.category);
---
<a class:list={['product-card', {'product-cutout': product.image.endsWith('.webp')}]} href={withBase(`/catalogo/${product.slug}/`)} data-product-id={product.id} data-category={product.category} data-name={`${product.name} ${product.summary} ${category?.name || ''}`}>
  <div class="product-card-image"><span class="product-index">{String(index + 1).padStart(2, '0')}</span><img src={withBase(product.image)} alt={product.name} loading="lazy" decoding="async" width="640" height="520"/><span class="product-arrow"><Icon name="diagonal" size={22}/></span></div>
  <div class="product-card-info"><p class="eyebrow">{category?.shortName}</p><h3>{product.name}</h3><span class="card-link">Explorar equipo <Icon name="arrow" size={15}/></span></div>
</a>
<style>
  .product-cutout .product-card-image{background:radial-gradient(ellipse at 50% 30%,#fcfeff 0%,#e5e9ef 68%,#d8dce2 100%)}
  .product-cutout .product-card-image img{mix-blend-mode:normal;filter:drop-shadow(0 14px 12px rgba(30,35,43,.14));padding:32px 30px 36px}
  @media(max-width:600px){.product-cutout .product-card-image img{padding:25px 14px 30px;filter:drop-shadow(0 7px 6px rgba(30,35,43,.12))}}
</style>

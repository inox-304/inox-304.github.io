---
import { withBase } from '../lib/paths';
import FlameLogo from './FlameLogo.astro';
import { adminEntryUrl } from '../lib/admin-entry';
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
const adminUrl = adminEntryUrl(import.meta.env.PUBLIC_CMS_MODE === 'api', import.meta.env.PUBLIC_ADMIN_URL);
---
{footer ? (
  <div class="footer-brand-entry">
    <button class="brand brand-footer" type="button" data-admin-entry={adminUrl} aria-label="INOX 304">
      <span class="brand-logo"><FlameLogo /></span>
    </button>
  </div>
) : (
  <a class="brand" href={withBase('/')} aria-label="INOX 304 — Inicio">
    <span class="brand-logo"><FlameLogo /></span>
  </a>
)}
<script>import '../scripts/admin-entry';</script>
<style>
  .footer-brand-entry{position:relative;flex-shrink:0}
  button.brand{padding:0;border:0;background:none;color:inherit;cursor:pointer;touch-action:manipulation;user-select:none;-webkit-tap-highlight-color:transparent}
  button.brand:focus-visible{outline:2px solid #b9c9de;outline-offset:5px;border-radius:4px}
  .brand-logo{display:block;width:218px;height:auto;max-height:87px;aspect-ratio:5/2}
  .brand-footer .brand-logo{width:232px}
  @media(max-width:1150px){.brand-logo{width:187px}}
  @media(max-width:600px){.brand-logo{width:166px;max-height:68px}.brand-footer .brand-logo{width:170px}}
</style>

---
import { formatProductPrice, safeTechnicalSheet } from '../lib/cms';
import { withBase } from '../lib/paths';
interface Props {
  product?: { price?: number; currency?: string; showPrice?: boolean; technicalSheet?: string };
}
const { product = {} } = Astro.props;
const price = formatProductPrice(product);
const technicalSheet = safeTechnicalSheet(product.technicalSheet || '');
---
<div class="product-commerce" data-product-commerce hidden={!price && !technicalSheet}>
  <p class="product-price" data-product-price hidden={!price}>{price}</p>
  <span data-product-unit hidden></span>
  <p class="product-availability" data-product-availability hidden></p>
  <label class="product-variants" data-product-variants hidden>Presentación<select data-product-variant aria-label="Presentación del equipo"></select></label>
  <div class="product-additional" data-product-additional hidden><p>Servicios adicionales</p><ul data-product-charges></ul></div>
  <a class="technical-sheet-link" data-product-technical-sheet href={technicalSheet ? withBase(technicalSheet) : undefined} target="_blank" rel="noopener noreferrer" hidden={!technicalSheet}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 3H6v18h12V7zM14 3v5h4M9 13h6M9 17h6"/></svg>
    Ver ficha técnica PDF <span aria-hidden="true">↗</span>
  </a>
</div>
<style>
  .product-commerce { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; padding-block: 10px 22px; }
  .product-price { margin: 0; font-size: clamp(1.35rem, 2.3vw, 1.8rem); font-weight: 600; letter-spacing: -.025em; color: var(--ink, #142335); }
  .technical-sheet-link { display: inline-flex; align-items: center; gap: 8px; font-size: .85rem; font-weight: 600; text-underline-offset: 5px; }
  .technical-sheet-link:hover { text-decoration: underline; }
  .product-availability, .product-variants, .product-additional { flex-basis: 100%; font-size: .85rem; margin: 0; }
  .product-variants select { display: block; width: 100%; margin-top: 8px; padding: 12px; border: 1px solid #ced9e5; background: #f5f8fb; color: inherit; font: inherit; border-radius: 3px; }
  .product-additional ul { padding-left: 20px; }
  .product-commerce[hidden], .product-commerce [hidden] { display: none; }
</style>

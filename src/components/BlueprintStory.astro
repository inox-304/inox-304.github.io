---
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';
import { whatsappUrl } from '../data/site';
---
<section id="a-medida" class="blueprint-story" aria-labelledby="blueprint-title" data-blueprint-story>
  <div class="shell blueprint-layout">
    <div class="blueprint-copy">
      <span class="eyebrow">SOLUCIONES A TU MEDIDA</span>
      <h2 id="blueprint-title">Tu idea. <br/>Nuestro oficio. <br/><span>Hecha realidad.</span></h2>
      <p>Del primer plano al último acabado. Diseñamos y fabricamos en acero inoxidable para que cada pieza encaje en tu proyecto.</p>
      <a class="button button-quote" data-contact-setting="contacto_medida" href={whatsappUrl('Hola INOX 304, tengo un proyecto de fabricación a medida. Me gustaría recibir asesoría.')} target="_blank" rel="noopener noreferrer">Hablemos de tu idea <Icon name="diagonal" size={18}/></a>
      <ul class="blueprint-services" aria-label="Acompañamiento del proyecto">
        <li><Icon name="check" size={15}/>Diseño</li><li><Icon name="check" size={15}/>Fabricación</li><li><Icon name="check" size={15}/>Instalación</li>
      </ul>
    </div>
    <div class="blueprint-demo">
      <div class="blueprint-view" style="--built:50%" data-blueprint-view>
        <img class="blueprint-finished" src={withBase('/images/brand/kitchen-finished.webp')} width="1774" height="887" alt="Visualización ilustrativa de una cocina profesional terminada en acero inoxidable" loading="lazy" decoding="async"/>
        <img class="blueprint-drawing" src={withBase('/images/brand/kitchen-blueprint.webp')} width="1774" height="887" alt="" aria-hidden="true" loading="lazy" decoding="async"/>
        <div class="blueprint-seam" aria-hidden="true"></div>
        <div class="blueprint-labels" aria-hidden="true"><span>EL PLANO</span><span>EL RESULTADO</span></div>
      </div>
      <div class="blueprint-controls">
        <label for="blueprint-progress">Del plano al acero</label>
        <button type="button" class="blueprint-toggle" data-blueprint-toggle aria-pressed="false">Reproducir transformación</button>
        <input type="range" id="blueprint-progress" min="0" max="100" value="50" step="1" aria-label="Mostrar la cocina terminada" aria-valuetext="50 % de cocina terminada" data-blueprint-range/>
        <span class="blueprint-hint">Desliza para ver la transformación</span>
      </div>
    </div>
  </div>
</section>
<style>
  .blueprint-story{position:relative;background:#052039;color:#f4f9ff;border-block:1px solid #274a64;padding-block:60px}
  .blueprint-layout{display:grid;grid-template-columns:minmax(280px,.85fr) minmax(0,1.6fr);gap:clamp(28px,4vw,68px);align-items:center}
  .blueprint-copy>.eyebrow{color:#9dcced;font-size:9px;letter-spacing:2.1px;margin-bottom:20px}
  .blueprint-copy h2{font-size:clamp(34px,3.1vw,49px);line-height:1.08;letter-spacing:-1.5px;font-weight:500;margin:0 0 22px}
  .blueprint-copy h2 span{color:#afd7f3}
  .blueprint-copy>p{font-size:13px;line-height:1.85;color:#c3d6e7;max-width:345px;margin-bottom:26px}
  .blueprint-copy .button{font-size:12px;gap:22px}
  .blueprint-services{display:flex;flex-wrap:wrap;gap:9px 18px;margin:24px 0 0;padding:0;list-style:none;color:#c3d6e7;font-size:11px}
  .blueprint-services li{display:flex;align-items:center;gap:6px}
  .blueprint-services svg{color:#8dc9f1}
  .blueprint-demo{min-width:0}
  .blueprint-view{position:relative;isolation:isolate;aspect-ratio:2/1;overflow:hidden;border:1px solid #4a7898;border-radius:9px;background:#07315a}
  .blueprint-view img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .blueprint-drawing{clip-path:inset(0 var(--built) 0 0)}
  .blueprint-seam{position:absolute;inset:0 auto 0 calc(100% - var(--built));width:2px;background:#c7ecff;box-shadow:0 0 18px #81ccf1;pointer-events:none}
  .blueprint-labels{position:absolute;inset:15px 15px auto;display:flex;justify-content:space-between;gap:15px;pointer-events:none}
  .blueprint-labels span{padding:7px 9px;border:1px solid #6d95ad;border-radius:4px;background:#052039e8;color:#e7f4ff;letter-spacing:1.8px;font-size:8px;line-height:1.3}
  .blueprint-controls{display:grid;grid-template-columns:1fr auto;align-items:center;gap:9px 16px;padding:15px 0 0}
  .blueprint-controls label{font-size:13px;font-weight:500;color:#e2eff9}
  .blueprint-toggle{min-height:44px;padding:7px 12px;border-radius:7px;border:1px solid #416685;background:#0d314e;color:#cbe6fa;font-size:10px;line-height:1.35}
  .blueprint-toggle:hover{background:#184363;border-color:#a5cce8}
  .blueprint-controls input{grid-column:1/-1;width:100%;height:44px;margin:0;accent-color:#8bcaef;cursor:ew-resize}
  .blueprint-hint{grid-column:1/-1;font-size:10px;color:#a9c1d5}
  @media(min-width:1700px){.blueprint-story{padding-block:76px}.blueprint-view{aspect-ratio:1.9}}
  @media(max-width:900px){.blueprint-layout{grid-template-columns:1fr;gap:32px}.blueprint-copy{max-width:600px}.blueprint-copy h2 br{display:none}.blueprint-copy h2{line-height:1.15;max-width:530px}.blueprint-copy h2 span{display:block}.blueprint-copy>p{max-width:520px}.blueprint-story{padding-block:46px}}
  @media(max-width:600px){.blueprint-copy h2{font-size:34px;letter-spacing:-1px}.blueprint-copy>.eyebrow{font-size:8px}.blueprint-copy>p{font-size:12px}.blueprint-story{padding-block:38px}.blueprint-labels{inset:9px 9px auto}.blueprint-labels span{font-size:6px;padding:5px 6px;letter-spacing:1px}.blueprint-controls label{font-size:12px}.blueprint-toggle{max-width:150px;font-size:9px}.blueprint-copy .button{min-height:46px}}
  @media(forced-colors:active){.blueprint-seam{background:Highlight;box-shadow:none}.blueprint-toggle{border-color:ButtonText}}
</style>
<script>
  import '../scripts/blueprint-story';
</script>

---
import { withBase } from '../lib/paths';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';
---
<footer class="site-footer">
  <div class="shell footer-top">
    <div><Brand footer/><p>Diseñamos. Fabricamos. Instalamos.<br/>Acero que está a la altura de tu negocio.</p></div>
    <div class="footer-column"><span class="eyebrow">EXPLORA</span><a href={withBase('/catalogo/')}>Nuestros equipos</a><a href={withBase('/#a-medida')}>Fabricación a medida</a><a href={withBase('/#instalaciones')}>Instalaciones y servicios</a><a href={withBase('/#nosotros')}>Conoce INOX 304</a></div>
    <div class="footer-column"><span class="eyebrow">CONVERSEMOS</span><a data-cms-whatsapp href={whatsappUrl()} target="_blank" rel="noopener noreferrer"><span data-cms-phone>{site.phone ? `+51 ${site.phone}` : ''}</span> <Icon name="diagonal" size={14}/></a><a data-cms-email href={site.email ? `mailto:${site.email}` : undefined} hidden={!site.email}>{site.email}</a><a data-cms-facebook href={site.facebook || undefined} hidden={!site.facebook} target="_blank" rel="noopener noreferrer">Facebook <Icon name="diagonal" size={14}/></a><a data-cms-social="instagram" href={site.instagram || undefined} hidden={!site.instagram} target="_blank" rel="noopener noreferrer">Instagram <Icon name="diagonal" size={14}/></a><a data-cms-social="tiktok" href={site.tiktok || undefined} hidden={!site.tiktok} target="_blank" rel="noopener noreferrer">TikTok <Icon name="diagonal" size={14}/></a></div>
    <div class="footer-column"><span class="eyebrow">ENCUÉNTRANOS</span><p><span data-business="direccion">{site.address}</span><br/><span class="muted" data-business="referencia_direccion">{site.addressReference}</span></p><p data-business="horarios" data-hide-empty hidden={!site.hours}>{site.hours}</p><a href={withBase('/contacto/')}>Ver ubicación <Icon name="arrow" size={14}/></a></div>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} <span data-business="empresa">INOX 304</span>. Todos los derechos reservados.</span><span>HECHO PARA DURAR.</span><a href="#top">Volver arriba ↑</a></div>
</footer>

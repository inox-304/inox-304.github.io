---
import { withBase } from '../lib/paths';
import { getProductStage } from '../lib/product-stage';
import type { Product } from '../data/products';
interface Props { product: Product; category: string }
const { product, category } = Astro.props;
const stage = getProductStage(product.image);
---
<div class="product-detail-photo product-photo-white">
  <span class="eyebrow" data-product-id-label>INOX 304 / {product.id}</span>
  <div class="equipment-crop">
    <img class="equipment-image" src={withBase(product.image)} alt={product.name} width={stage.width} height={stage.height} fetchpriority="high"/>
  </div>
  <span class="photo-caption" data-product-caption>{category.toUpperCase()}</span>
</div>
<style>
  .product-detail-photo.product-photo-white {
    background: #fff; aspect-ratio: 1; min-height: 0; width: 100%; overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto;
    gap: 12px; padding: clamp(18px, 4.5%, 30px);
    border: 1px solid #e0e5eb;
  }
  .product-photo-white .equipment-crop { display: block; min-height: 0; height: 100%; }
  .product-photo-white .equipment-image {
    width: 100%; height: 100%; max-height: none; aspect-ratio: auto;
    object-fit: contain; padding: 0; mix-blend-mode: normal; filter: none;
  }
  .product-photo-white > .eyebrow, .product-photo-white > .photo-caption { color: #536372; }
  .product-photo-white > .photo-caption { border-color: #e0e5eb; }
</style>

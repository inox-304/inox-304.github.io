---
import { withBase } from '../lib/paths';
import type { Product } from '../data/products';
interface Props { product: Product; category: string }
const { product, category } = Astro.props;
const isCutout = product.image.endsWith('.webp');
---
<div class:list={['product-detail-photo', {'product-studio': isCutout}]}>
  <picture class="studio-backdrop" aria-hidden="true" hidden={!isCutout}>
    <source media="(max-width: 600px)" srcset={withBase('/images/brand/studio-portrait.webp')}/>
    <source media="(max-width: 900px)" srcset={withBase('/images/brand/studio-landscape.webp')}/>
    <img src={withBase('/images/brand/studio-wide.webp')} alt="" width="1672" height="941"/>
  </picture>
  <span class="eyebrow" data-product-id-label>INOX 304 / {product.id}</span>
  <img class="equipment-image" src={withBase(product.image)} alt={product.name} width="800" height="800" fetchpriority="high"/>
  <span class="photo-caption" data-product-caption>{category.toUpperCase()}</span>
</div>
<style>
  .product-studio{isolation:isolate;aspect-ratio:1;min-height:0;overflow:hidden;background:#172020;padding:26px}
  .studio-backdrop{position:absolute;inset:0;z-index:-1;pointer-events:none}
  .studio-backdrop img{padding:0;width:100%;height:100%;max-height:none;aspect-ratio:auto;object-fit:cover;mix-blend-mode:normal}
  .product-studio .equipment-image{position:absolute;inset:auto 10% 17%;width:80%;height:67%;padding:0;aspect-ratio:auto;max-height:none;object-fit:contain;object-position:center bottom;mix-blend-mode:normal;filter:drop-shadow(0 15px 12px rgba(0,0,0,.32))}
  .product-studio>.eyebrow{position:relative;color:#e0e2dc;font-size:9px;z-index:1}
  .product-studio>.photo-caption{position:relative;color:#e0e2dc;border-color:#8c928f;font-size:8px;margin-top:auto;z-index:1}
  @media(min-width:601px) and (max-width:900px){.product-studio{aspect-ratio:4/3}}
  @media(max-width:600px){.product-studio{aspect-ratio:3/4;padding:20px}.product-studio .equipment-image{bottom:17%;height:61%;inset-inline:7%;width:86%}}
</style>

---
import { withBase } from '../lib/paths';
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { whatsappUrl } from '../data/site';
import '../styles/header.css';
const pathname = Astro.url.pathname;
---
<header class:list={['site-header', { 'site-header-overlay': pathname === withBase('/') || pathname === withBase('/').replace(/\/$/, '') }]}>
  <div class="header-inner shell">
    <Brand />
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href={withBase('/catalogo/')} aria-current={pathname.startsWith(withBase('/catalogo/')) ? 'page' : undefined}>Catálogo</a>
      <a href={withBase('/#a-medida')}>A medida</a>
      <a href={withBase('/#instalaciones')}>Instalaciones</a>
      <a href={withBase('/#nosotros')}>Nosotros</a>
      <a href={withBase('/contacto/')} aria-current={pathname === withBase('/contacto/') ? 'page' : undefined}>Contacto</a>
    </nav>
    <a class="header-search" href={pathname === withBase('/catalogo/') ? '#catalog-search' : withBase('/catalogo/#catalog-search')} aria-label="Buscar equipos en el catálogo"><Icon name="search" size={19}/><span>Buscar</span></a>
    <a class="header-cta button-quote" data-cms-whatsapp href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Hablemos de tu proyecto <Icon name="diagonal" size={17}/></a>
    <button type="button" class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu"><span aria-hidden="true"></span><span aria-hidden="true"></span></button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label="Navegación móvil" hidden>
    <a href={withBase('/catalogo/')} aria-current={pathname.startsWith(withBase('/catalogo/')) ? 'page' : undefined}>Catálogo <Icon/></a><a href={withBase('/#a-medida')}>A medida <Icon/></a><a href={withBase('/#instalaciones')}>Instalaciones <Icon/></a><a href={withBase('/#nosotros')}>Nosotros <Icon/></a><a href={withBase('/contacto/')} aria-current={pathname === withBase('/contacto/') ? 'page' : undefined}>Contacto <Icon/></a>
    <a class="button-quote" data-cms-whatsapp href={whatsappUrl()} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp <Icon name="whatsapp"/></a>
  </nav>
</header>
<style>
  /* Keep navigation visually separate from the moving hero on every page. */
  .site-header,
  .site-header.site-header-overlay {
    background: #071f34;
    border-bottom: 1px solid #24465f;
    box-shadow: 0 4px 18px rgb(2 16 29 / 14%);
  }
  .site-header .mobile-nav {
    background: #071f34;
    border-color: #24465f;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  const header = toggle?.closest('header');
  function closeMenu() {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Abrir menú'); menu.hidden = true;
  }
  toggle?.addEventListener('click', () => {
    if (!menu || !toggle) return;
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen)); toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú'); menu.hidden = isOpen;
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  // This is a disclosure, not a modal: let focus move normally and close it outside.
  function closeOutside(event: Event) { if (event.target instanceof Node && header && !header.contains(event.target)) closeMenu(); }
  document.addEventListener('pointerdown', closeOutside);
  document.addEventListener('focusin', closeOutside);
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
  window.matchMedia('(min-width: 901px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
</script>

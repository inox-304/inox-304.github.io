# Recommended: Apps Script export endpoint, only consumed at build time.
# No password or Google access token belongs here.
CMS_EXPORT_URL=

# Optional legacy direct CSV mode. Leave blank when using CMS_EXPORT_URL.
# Leave empty until the INOX Google account is connected and the sheet is ready.
PUBLIC_CMS_CATALOG_URL=
PUBLIC_CMS_CONTACTS_URL=
PUBLIC_CMS_SETTINGS_URL=

# GitHub Pages uses the account website at the root path.
PUBLIC_SITE_URL=https://inox-304.github.io
PUBLIC_SITE_BASE_PATH=/

# Static GitHub Pages compatibility. The private panel uses backend/.env.
PUBLIC_SITE_URL=https://inox-304.github.io
PUBLIC_SITE_BASE_PATH=/
PUBLIC_CMS_MODE=static
# Once Django is hosted, the footer shortcut opens its protected login.
# PUBLIC_ADMIN_URL=https://your-domain.example/admin/
# npm run build:server explicitly selects API mode for the Django runtime.

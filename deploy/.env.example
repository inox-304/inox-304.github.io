# Copy to a PRIVATE deployment environment; never commit populated values.
# This example configures the existing Docker installation, not a hosting plan.
INOX_DOMAIN=panel.example.com
POSTGRES_PASSWORD=
# Preserve the effective source key when migrating an existing installation.
DJANGO_SECRET_KEY=
CATALOG_BACKUP_KEY=

SECURITY_OWNER_USERNAME=owner@example.com
# Enable only after the final HTTPS address and private data are verified.
SECURITY_PASSKEYS_ENABLED=0
SECURITY_EMAIL_ENABLED=0
EMAIL_BACKEND=security.smtp_backend.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Copy the existing credential separately to the private persistent volume:
# /data/credentials/google-sheets-reader.json, readable only by UID 10001.
INOX_INVENTORY_REFRESH_ENABLED=0
INOX_INVENTORY_SHEET_ID=

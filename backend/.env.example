# Development only. Copy to backend/.env; do not commit the real file.
DJANGO_ENV=development
PUBLIC_SITE_URL=http://127.0.0.1:8000
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# INOX_DATA_DIR can point outside the checkout to preserve data across releases.
# INOX_DATA_DIR=C:/inox304-data

# Email verification: configure with CONFIGURAR-CORREO.cmd or set these privately.
# Never use the panel password here. Gmail requires a Google app password.
SECURITY_EMAIL_ENABLED=0
EMAIL_BACKEND=security.smtp_backend.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Passkeys: enable only after choosing the panel's stable HTTPS domain.
# Use localhost (never 127.0.0.1) for isolated development ceremonies.
SECURITY_PASSKEYS_ENABLED=0
SECURITY_OWNER_USERNAME=
SECURITY_PASSKEY_RP_ID=
SECURITY_PASSKEY_ORIGIN=
# SECURITY_PASSKEY_RP_ID=admin.your-domain.com
# SECURITY_PASSKEY_ORIGIN=https://admin.your-domain.com

# Production requires HTTPS, an explicit secret and persistent PostgreSQL.
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=GENERATE_A_RANDOM_SECRET_OUTSIDE_GIT
# DATABASE_URL=postgresql://inox:PASSWORD@db:5432/inox
# DATABASE_SSLMODE=require
# PUBLIC_SITE_URL=https://your-domain.com
# DJANGO_ALLOWED_HOSTS=your-domain.com
# TRUST_REVERSE_PROXY=1

# Private read-only inventory connection. Never use PUBLIC_* for credentials.
# INOX_INVENTORY_SHEET_ID=YOUR_PRIVATE_SPREADSHEET_ID
# GOOGLE_APPLICATION_CREDENTIALS=ABSOLUTE_PRIVATE_CREDENTIALS_PATH
# INOX_INVENTORY_REFRESH_ENABLED=1
